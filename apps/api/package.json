{
  "name": "@taskforge/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "start": "node dist/apps/api/src/index.js",
    "prestart:dev": "pnpm --filter @taskforge/contracts build",
    "start:dev": "tsx watch src/index.ts",
    "start:worker": "node dist/apps/api/src/worker.js",
    "prestart:worker:dev": "pnpm --filter @taskforge/contracts build",
    "start:worker:dev": "tsx watch src/worker.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.integration.json --noEmit",
    "lint": "eslint src tests prisma/*.ts prisma.config.ts",
    "lint:fix": "eslint src tests prisma/*.ts prisma.config.ts --fix",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js",
    "pretest:integration:postgres": "pnpm --filter @taskforge/contracts build",
    "test:integration:postgres": "tsx tests/integration/run-postgres-integration.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@taskforge/contracts": "workspace:*",
    "argon2": "0.45.1",
    "bullmq": "6.0.5",
    "cookie-parser": "1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "file-type": "22.0.1",
    "helmet": "^8.1.0",
    "ioredis": "6.0.0",
    "jose": "6.2.7",
    "multer": "2.2.0",
    "pg": "8.22.0",
    "pino": "^9.6.0",
    "pino-http": "^10.5.0",
    "socket.io": "4.8.3",
    "swagger-ui-express": "5.0.1",
    "zod": "^3.25.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "2.0.0",
    "@types/node": "^24.7.2",
    "@types/pg": "8.20.3",
    "@types/pino-http": "^5.3.2",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "jest": "^29.7.0",
    "prisma": "7.9.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.7",
    "tsx": "^4.20.0",
    "typescript": "^5.8.2"
  }
}
