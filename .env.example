# Shared
NODE_ENV=development
LOG_LEVEL=debug
REQUEST_ID_HEADER=x-request-id

# API
API_PORT=4000
API_BASE_PATH=/api/v1
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://0.0.0.0:3000
API_MAX_JSON_BYTES=1048576
API_BODY_BYTES=5242880
API_RATE_LIMIT_WINDOW_MS=60000

# Auth and sessions (Phase 3+)
JWT_ACCESS_SECRET=dev-only-access-secret-change-before-production-1234567890abcdef
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-before-production-1234567890abcdef
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
REFRESH_ROTATION_REDIS_TTL_SECONDS=604800
JWT_ISSUER=taskforge-api
JWT_AUDIENCE=taskforge-web
COOKIE_SECURE=false
CSRF_HEADER=x-csrf-token

# Data and queue
TASKFORGE_POSTGRES_PORT=5432
TASKFORGE_REDIS_PORT=6379
DATABASE_URL=postgresql://taskforge:taskforge@localhost:5432/taskforge
DATABASE_URL_TEST=postgresql://taskforge:taskforge@localhost:5432/taskforge_test
REDIS_URL=redis://localhost:6379
REDIS_URL_TEST=redis://localhost:6379/15

# Web
WEB_PORT=3000
NEXT_PUBLIC_API_ORIGIN=http://localhost:4000
NEXT_PUBLIC_API_BASE_PATH=/api/v1

# Files and worker
TASK_FILE_STORAGE_PATH=./storage/tasks
TASK_MAX_FILE_SIZE_BYTES=8388608
TASK_MAX_FILES=5
