# Shared
NODE_ENV=development
LOG_LEVEL=debug
REQUEST_ID_HEADER=x-request-id

# API
API_PORT=4000
API_BASE_PATH=/api/v1
API_CORS_ORIGINS=http://localhost:3000
API_MAX_JSON_BYTES=1048576
API_BODY_BYTES=5242880
API_RATE_LIMIT_WINDOW_MS=60000

# Auth and sessions (Phase 2+)
JWT_ACCESS_SECRET=<generate-with-open-ssl>
JWT_REFRESH_SECRET=<generate-with-open-ssl>
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
REFRESH_ROTATION_REDIS_TTL_SECONDS=604800

# Data and queue (Phase 2+)
DATABASE_URL=postgresql://taskforge:taskforge@postgres:5432/taskforge
DATABASE_URL_TEST=postgresql://taskforge:taskforge@postgres:5432/taskforge_test
REDIS_URL=redis://redis:6379

# Web
WEB_PORT=3000
NEXT_PUBLIC_API_ORIGIN=http://localhost:4000
NEXT_PUBLIC_API_BASE_PATH=/api/v1

# Files and worker
TASK_FILE_STORAGE_PATH=./storage/tasks
TASK_MAX_FILE_SIZE_BYTES=8388608
TASK_MAX_FILES=5
